[resource]
script = ExtResource("1")
entry_id = "regenerate"
entry_name = "Regenerate"
description = "Channel restorative magic. Heal a target ally within range for twice your weapon's damage roll."
phases = 2
weapon_requirements = Array[String](["ball", "tome"])
cooldown_turns = 3
actions = [SubResource("action_heal")]
